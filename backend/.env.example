PORT=3000
CLIENT_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://library_app:replace_with_database_password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_SSL=enable
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional: path, relative to backend/, for the CA certificate from Supabase Database SSL Configuration.
# DATABASE_SSL_CA_PATH=supabase-ca.crt
AUTH_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_characters
